# Entorno de ejecución (development / production)
ENVIRONMENT=development

# Configuración de Base de Datos
DB_PATH=database/aethel.db

# Configuración de Inteligencia Artificial
AI_PROVIDER=gemini
AI_API_KEY=tu_clave_sin_comillas
AI_MODEL=gemini-3.8-flash
# Modelos alternativos separados por comas; vacío desactiva fallback.
AI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Respaldo local opcional mediante Ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=120
# Orden de estrategia: Gemini, Ollama local y reglas offline
LLM_PROVIDER_ORDER=gemini,ollama,offline

# Retención y cifrado opcional del historial local
CONTEXT_RETENTION_DAYS=30
# Genera una clave Fernet con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONTEXT_ENCRYPTION_KEY=