# Entorno de ejecución (development / production)
ENVIRONMENT=development

# Configuración de Base de Datos
DB_PATH=database/aethel.db

# Estrategia de proveedores: Ollama local primero, Gemini como respaldo y
# reglas offline como último recurso.
LLM_PROVIDER_ORDER=ollama,gemini,offline

# Ollama local (no requiere API key)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
# false evita el razonamiento interno de modelos como qwen3 y reduce mucho
# la latencia. Actívalo solo si necesitas cadenas de razonamiento largas.
OLLAMA_THINK=false
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=512
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT_SECONDS=120

# Gemini (opcional, solo si aparece en LLM_PROVIDER_ORDER)
AI_API_KEY=tu_clave_sin_comillas
AI_MODEL=gemini-3.8-flash
AI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Presupuesto local acumulado por ejecución
LLM_BUDGET_USD=0.50

# Retención y cifrado opcional del historial local
CONTEXT_RETENTION_DAYS=30
# Genera una clave Fernet con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONTEXT_ENCRYPTION_KEY=

# Perfil externo de personalidad
PERSONALITY_PATH=prompts/persona.yaml
PERSONALITY_MODE=enfoque
